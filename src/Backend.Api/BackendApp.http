@BackendApp_HostAddress = http://localhost:5000

GET {{BackendApp_HostAddress}}/weatherforecast/
Accept: application/json

### Get All
GET {{BackendApp_HostAddress}}/api/v1/products
Accept: application/json


### Get Product by ProductCode
GET {{BackendApp_HostAddress}}/api/v1/products/PR-001
Accept: application/json

### Practice Product not Found
GET {{BackendApp_HostAddress}}/api/v1/products/P0100
Accept: application/json

### Create Product
POST {{BackendApp_HostAddress}}/api/v1/products
Accept: application/json
Content-Type: application/json 

# {
#     "productCode": "P002", 
#     "name": "Jaket Hoodie Polos",
#     "price": 250000, 
#     "stock": 60, 
#     "category": "Outerwear"
# }

{

    "productCode": "P003", 
    "name": "Kemeja Flanel Kotak",
    "price": 220000, 
    "stock": 75, 
    "category": "Atasan"
}


### Delete Product
DELETE  {{BackendApp_HostAddress}}/api/v1/products/PR-001
Accept: application/json

### Update
PUT {{BackendApp_HostAddress}}/api/v1/products/PR-001
Accept: application/json
Content-Type: application/json 

{
    "name": "Kaos Polos Cotton Combed",
    "price": 75000, 
    "stock": 150, 
    "category": "Atasan"
}


# * ======= Customer =======
### Get All Customer
GET {{BackendApp_HostAddress}}/api/v1/customers
Accept: application/json


### Get Customer by email
GET {{BackendApp_HostAddress}}/api/v1/customers/dzn@gmail.com
Accept: application/json

### Practice Customer not Found
GET {{BackendApp_HostAddress}}/api/v1/customers/bandotes@gmail.com
Accept: application/json

### Create Product
POST {{BackendApp_HostAddress}}/api/v1/customers
Accept: application/json
Content-Type: application/json 

{
    "name": "Dika",
    "email": "dika@gmail.com", 
    "phone": "89530212", 
    "address": "Demak"
}


### Delete Customer by Email
DELETE  {{BackendApp_HostAddress}}/api/v1/customers/DZN@GMAIL.COM
Accept: application/json

### Update By Email
PUT {{BackendApp_HostAddress}}/api/v1/customers/DZN@GMAIL.COM
Accept: application/json
Content-Type: application/json 

{
    "name": "Dany Z",
    "email": "danyzkr@gmail.com", 
    "phone": "92109310", 
    "address": "Oslo"
}

